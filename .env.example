# ─────────────────────────────────────────────────────────────
# サツコイ！（仮） — 環境変数テンプレート
# `.env` にコピーして各値を設定してください。
# ─────────────────────────────────────────────────────────────

# PostgreSQL 接続文字列
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/satukoi?schema=public"

# Prisma 7 schema-engine バイナリのパス（ネットワーク制限環境のみ必要）。
# 通常は npm install の postinstall が自動取得するため未設定で可。
# PRISMA_SCHEMA_ENGINE_BINARY="/abs/path/to/schema-engine-<target>"

# セッション署名鍵（32文字以上推奨）
AUTH_SECRET="change-me"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# アプリのベース URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
