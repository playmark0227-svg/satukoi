# ─────────────────────────────────────────────────────────────
# サツコイ！（仮） — 環境変数テンプレート
# `.env` にコピーして各値を設定してください。
# ─────────────────────────────────────────────────────────────

# PostgreSQL 接続文字列
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/satukoi?schema=public"

# Prisma 7 schema-engine バイナリのパス（ネットワーク制限環境のみ必要）。
# 通常は npm install の postinstall が自動取得するため未設定で可。
# PRISMA_SCHEMA_ENGINE_BINARY="/abs/path/to/schema-engine-<target>"

# セッション署名鍵（32文字以上推奨）
AUTH_SECRET="change-me"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# アプリのベース URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── LINE（LIFF）──
# LINE Developers で作成した LIFF アプリの ID（例: 1234567890-AbCdEfGh）。
# 未設定の場合は通常の Web アプリとして動作（LINE ログインボタンは無効）。
NEXT_PUBLIC_LIFF_ID=""
# LIFF アプリを作成した「LINE ログイン」チャネルのチャネルID（ID トークン検証に使用）
LINE_LOGIN_CHANNEL_ID=""

# ── LINE 公式アカウント（Messaging API：通知の送信・Webhook）──
# 未設定の場合、LINE 通知は送信せずログ出力のみ（アプリ内通知は通常どおり）。
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=""
LINE_MESSAGING_CHANNEL_SECRET=""
# 公式アカウントのベーシックID（例: @123abcde）。通知設定画面の「友だち追加」ボタンに使用。
NEXT_PUBLIC_LINE_OA_ID=""
